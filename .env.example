# Port Backend Lokal
PORT=5000

# MongoDB Atlas Connection String (Dapatkan gratis di https://cloud.mongodb.com)
# Contoh: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/student_hub?retryWrites=true&w=majority

# JWT Secret Key (Ketik string acak dan aman)
JWT_SECRET=rahasia_super_aman_jwt_mahasiswa_123456

# Google OAuth 2.0 Client ID (Opsional, dari Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client URL (Untuk CORS jika diperlukan)
CLIENT_URL=http://localhost:5173
